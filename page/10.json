"new_string": "//^function EngageControl(props:{label:string;value:number;offValue:number;offLabel?:string;onChange:(n:number)=>void;disabled?:boolean;hint?:string}){const theme=useGrokTheme();const off=props.offValue===0?props.value<=0:props.value<0;const apply=(n:number)=>{if(props.disabled)return;if(n<0){props.onChange(props.offValue===0?0:-1);return;} props.onChange(Math.min(1000000,n));};const bump=(dir:1|-1)=>{if(props.disabled)return;if(off){if(dir>0)apply(props.offValue===0?1:0);return;} const next=props.value+dir;if(next<0){apply(props.offValue);return;} apply(next);};const onTyped=(v:string)=>{const t=v.replace(/[^\\d]/g,\"\");if(t===\"\"){apply(props.offValue);return;} const n=parseInt(t,10);if(Number.isFinite(n))apply(n);};return(<div className=\"xpc-engage\" style={{opacity:props.disabled?0.55:1}}><div style={{fontSize:13,color:theme.text.secondary}}>{props.label}</div><div className=\"xpc-engage-row\"><button type=\"button\" className=\"xpc-engage-off\" aria-pressed={off} disabled={props.disabled} onClick={()=>apply(props.offValue)} style={{background:off?theme.fill.accentSubtle:theme.bg.base,border:`${off?1.5:1}px solid ${off?theme.border.focus:theme.border.default}`,color:theme.text.primary,fontFamily:theme.font.family}}>{props.offLabel??\"Off\"}</button><button type=\"button\" className=\"xpc-engage-step\" aria-label=\"Decrease\" disabled={props.disabled||off} onClick={()=>bump(-1)} style={{background:theme.bg.base,border:`1px solid ${theme.border.default}`,color:theme.text.primary,fontFamily:theme.font.family}}>−</button><input className=\"xpc-engage-num\" type=\"text\" inputMode=\"numeric\" pattern=\"[0-9]*\" aria-label={props.label} disabled={props.disabled} value={off?\"\":String(props.value)} placeholder=\"Off\" onChange={(e:{target:{value:string}})=>onTyped(e.target.value)} style={{background:theme.bg.base,border:`1px solid ${theme.border.default}`,color:theme.text.primary,fontFamily:theme.font.family}}/><button type=\"button\" className=\"xpc-engage-step\" aria-label=\"Increase\" disabled={props.disabled} onClick={()=>bump(1)} style={{background:theme.bg.base,border:`1px solid ${theme.border.default}`,color:theme.text.primary,fontFamily:theme.font.family}}>+</button></div><div className=\"xpc-engage-chips\">{ENGAGE_PRESETS.map((n)=>{const on=!off&&props.value===n;return(<button key={n} type=\"button\" aria-pressed={on} disabled={props.disabled} onClick={()=>apply(n)} className=\"xpc-engage-chip\" style={{background:on?theme.fill.accentSubtle:theme.bg.base,border:`${on?1.5:1}px solid ${on?theme.border.focus:theme.border.default}`,color:theme.text.primary,fontFamily:theme.font.family}}>{formatEngage(n)}</button>);})}</div>{props.hint?<div style={{fontSize:13,color:theme.text.secondary,lineHeight:1.45}}>{props.hint}</div>:null}</div>);}"
