order:`1px solid ${theme.border.default}`,background:theme.bg.subtle,padding:\"16px 18px\",display:\"flex\",flexDirection:\"column\",gap:10}}><div style={_s2}>Remove outdated results</div><div style={{fontSize:14,color:theme.text.secondary,lineHeight:1.5,flex:1}}>The bot files Google's Remove Outdated Content requests for deleted post URLs. You sign in to Google once. Removal isn't guaranteed.</div><div style={_s12}>Bot files the requests after you sign in to Google.</div>{tapLine(\"File removal requests with the tap card in the chat.\")}<Toggle label=\"Recheck in 30 days\" value={kitGoogleRecheck} onChange={setKitGoogleRecheck}/></div><div style={{borderRadius:14,border:`1px solid ${theme.border.default}`,background:theme.bg.subtle,padding:\"16px 18px\",display:\"flex\",flexDirection:\"column\",gap:10}}><div style={_s2}>Wayback Machine</div><div style={{fontSize:14,color:theme.text.secondary,lineHeight:1.5,flex:1}}>The bot finds archived copies of your deleted posts, shows short clickable links, and prepares a removal-request email for you to review and send.</div><div style={_s9}>Links to archived copies appear here after the run.</div><div style={_s12}>Bot finds the copies and drafts the email. You review it and press Send.</div>{tapLine(\"Prepare the removal email with the tap card in the chat.\")}<Toggle label=\"Recheck in 30 days\" value={kitWaybackRecheck} onChange={setKitWaybackRecheck}/></div><div style={{borderRadius:14,border:`1px solid ${theme.border.default}`,background:theme.bg.subtle,padding:\"16px 18px\",display:\"flex\",flexDirection:\"column\",gap:10}}><div style={_s2}>Personal info (phone, address)</div>{fortressCard}</div></div><div>{tapLine(\"Delete the archive copy from the bot's computer with the tap card in the chat.\")}</div>{!maintOn?(<div style={{...panel,padding:16,display:\"flex\",flexDirection:\"column\",gap:10}}><div style={_s2}>Disconnect when you're done</div><div style={_s0}>After a one-time cleanup, you can disconnect access. We never do this unless you ask.</div><Button label={kitDisconnect?\"Walkthrough open\":\"Walk me through disconnecting\"} onClick={()=>setKitDisconnect(true)}/>{kitDisconnect&&(<div style={_s5}>{lane===\"fast\"?\"Open X Settings → Security and account access → Apps and sessions, and revoke the developer app you created (you can also remove it in console.x.com).\":\"No third-party app was added for the Free lane. Sign out of X in the bot's browser if you want to disconnect.\"}</div>)}</div>):(<div style={{fontSize:13,color:theme.text.tertiary,lineHeight:1.45}}>Disconnect is available after you turn maintenance off.</div>)}</div>)}<div id=\"run-tray\" style={{display:\"flex\",flexDirection:\"column\",gap:12}}><div style={subhead}>{failedCount>0?`Failure tray · ${failedCount} need a manual tap`:\"Failure tray is clear\"}</div>{failedCount>0&&(<><div style={_s11}>These didn't delete automatically. Open each link on X and delete it yourself if you still want it gone.</div><div style={{display:\"flex\",gap:10,flexWrap:\"wrap\"}}><Button label={showFailed?\"Hide links\":\"Show links\"} onClick={()=>setShowFailed(!showFailed)}/></div>{tapLine(\"Retry the failed posts with the tap card in the chat.\")}{showFailed&&(<Table columns={[\"Link\",\"Why\"]} rows={failedIds.map((id,i)=>[`https://x.com/you/status/${id}`,i===0?\"Button didn't respond\":i===1?\"X asked us to slow down\":\"Still visible after delete\"])}/>)}</>)}</div><div id=\"run-more\"><Section heading=\"Maintenance (optional)\" collapsible defaultOpen={false}><Toggle label=\"Weekly digest after this cleanup finishes\" value={maintOn} onChange={(v:boolean)=>{setMaintOn(v);if(!v)setAutoCont(false);}}/><Toggle label=\"Auto-continue without asking each week\" value={autoCont} onChange={setAutoCont} disabled={!maintOn}/>{maintOn&&(<Select label=\"Rolling cleanup: keep only the last\" value={rollWin} onChange={(v:string)=>setRollWin(v)} options={[{value:\"off\",label:\"Off\"},{value:\"30\",label:\"30 days\"},{value:\"90\",label:\"90 days\"},{value:\"365\",label:\"1 year\"}]}/>)}</Section></div></div>)}"
